# Wyłącznie lokalny Compose v2. Tokeny są w .local/secrets, nigdy tutaj.
RADH_HTTP_PORT=8080
RADH_IMAGE_TAG=local
# 1 zezwala węzłom na raport K; użytkownik musi też zaznaczyć opt-in w UI.
RADH_DIAGNOSTICS=0
# Adres jedynego zaufanego proxy musi należeć do poniższej podsieci.
RADH_SERVICES_SUBNET=172.30.87.0/24
RADH_PROXY_IP=172.30.87.10
