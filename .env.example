# Wyłącznie lokalny demonstrator v1. Ten plik nie zawiera poświadczeń.
RADH_HTTP_PORT=8080
RADH_IMAGE_TAG=local
# 1 włącza jawną edukacyjną diagnostykę K w UI; 0 pozostawia K w procesach.
RADH_DIAGNOSTICS=0
# Planowane tokeny usług/Owner z #68–71 nie są jeszcze obsługiwane przez main.
# Nie dodawaj fikcyjnych wartości sugerujących działającą autoryzację.
